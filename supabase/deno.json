{
  "tasks": {
    "test": "deno test --allow-env functions/",
    "check": "deno check functions/*/index.ts",
    "lint": "deno lint functions/",
    "fmt": "deno fmt functions/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@supabase/supabase-js": "jsr:@supabase/supabase-js@2"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "lineWidth": 140
  }
}
