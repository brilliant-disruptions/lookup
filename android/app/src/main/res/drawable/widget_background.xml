<?xml version="1.0" encoding="utf-8"?>
<!-- Night glass: deep navy to black, a hairline edge, generous corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#04060B"
        android:startColor="#0B1328" />
    <stroke
        android:width="1dp"
        android:color="#17FFFFFF" />
    <corners android:radius="22dp" />
</shape>
